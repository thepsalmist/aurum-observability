          "rawSql": "SELECT CASE WHEN m.average_loss IS NULL OR m.average_loss = 0 THEN NULL\n            ELSE m.average_win / abs(m.average_loss) END AS \"Reward : Risk\"\nFROM backtest_summary_metrics m\nJOIN backtest_runs r ON r.id = m.backtest_run_id\nWHERE r.run_id = '$run_id'"
