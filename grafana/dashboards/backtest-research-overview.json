          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.close_reason   AS \"Reason\",\n       c.total_trades   AS \"Trades\",\n       c.net_profit     AS \"Net Profit\",\n       c.average_profit AS \"Avg\",\n       c.win_rate_pct   AS \"Win %\"\nFROM backtest_close_reason_metrics c\nJOIN backtest_runs r ON r.id = c.backtest_run_id\nWHERE r.run_id = '$run_id'\nORDER BY c.total_trades DESC"
