      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.executed_at      AS \"Executed\",\n       r.run_id           AS \"Run\",\n       r.strategy_name    AS \"Strategy\",\n       r.variant_name     AS \"Variant\",\n       r.symbol           AS \"Symbol\",\n       r.timeframe        AS \"TF\",\n       r.period_start     AS \"From\",\n       r.period_end       AS \"To\",\n       r.status           AS \"Status\",\n       m.net_profit       AS \"Net Profit\",\n       m.max_drawdown_pct AS \"Max DD %\",\n       m.profit_factor    AS \"Profit Factor\",\n       m.expected_payoff  AS \"Expectancy\",\n       m.win_rate_pct     AS \"Win %\",\n       m.total_trades     AS \"Trades\"\nFROM backtest_runs r\nLEFT JOIN backtest_summary_metrics m ON m.backtest_run_id = r.id\nWHERE r.strategy_name LIKE '$strategy'\n  AND r.symbol LIKE '$symbol'\n  AND r.timeframe LIKE '$timeframe'\nORDER BY r.executed_at DESC\nLIMIT 50"
        }
      ]
