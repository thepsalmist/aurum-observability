          "rawSql": "SELECT occurred_at         AS \"Closed\",\n       mt5_position_ticket AS \"Ticket\",\n       symbol              AS \"Symbol\",\n       upper(direction)    AS \"Dir\",\n       volume              AS \"Lots\",\n       profit              AS \"P&L\",\n       reason              AS \"Reason\"\nFROM trade_events\nWHERE event_type = 'CLOSE'\n  AND bot_id = '$bot_id' AND symbol LIKE '$symbol'\nORDER BY occurred_at DESC\nLIMIT 15",
          "datasource": {
