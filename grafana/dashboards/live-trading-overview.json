          "rawSql": "SELECT observed_at AS \"time\", equity AS \"Equity\"\nFROM account_snapshots\nWHERE $__timeFilter(observed_at)\n  AND bot_id = '$bot_id'\nORDER BY 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
