{
  "title": "Live Trading Overview",
  "uid": "aurum-live-trading",
  "tags": [
    "aurum",
    "live-trading"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row",
      "title": "Bot Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Bot Status",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT lower(status) AS \"Status\"\nFROM bot_heartbeats\nWHERE bot_id = '$bot_id' AND symbol LIKE '$symbol'\nORDER BY observed_at DESC\nLIMIT 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "color": "green",
                  "index": 0,
                  "text": "HEALTHY"
                },
                "degraded": {
                  "color": "orange",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "stopped": {
                  "color": "red",
                  "index": 2,
                  "text": "STOPPED"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Heartbeat Age",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(observed_at)) AS \"Heartbeat Age\"\nFROM bot_heartbeats\nWHERE bot_id = '$bot_id' AND symbol LIKE '$symbol'",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Circuit Breaker",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE\n         WHEN bool_or(circuit_breaker_active) THEN 'TRIPPED'\n         WHEN count(*) > 0 THEN 'OK'\n       END AS \"Circuit Breaker\"\nFROM (\n  SELECT DISTINCT ON (symbol) circuit_breaker_active\n  FROM daily_risk_snapshots\n  WHERE trade_date = CURRENT_DATE\n    AND bot_id = '$bot_id' AND symbol LIKE '$symbol'\n  ORDER BY symbol, observed_at DESC\n) latest",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "TRIPPED": {
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "text",
                  "index": 2,
                  "text": "NO DATA TODAY"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Daily P&L",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(profit), 0) AS \"Daily P&L\"\nFROM trade_events\nWHERE event_type = 'CLOSE'\n  AND occurred_at >= date_trunc('day', now())\n  AND bot_id = '$bot_id' AND symbol LIKE '$symbol'",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Today W / L / Total",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sum(wins) AS \"Wins\", sum(losses) AS \"Losses\", sum(trades) AS \"Trades\"\nFROM (\n  SELECT DISTINCT ON (symbol) wins, losses, trades\n  FROM daily_risk_snapshots\n  WHERE trade_date = CURRENT_DATE\n    AND bot_id = '$bot_id' AND symbol LIKE '$symbol'\n  ORDER BY symbol, observed_at DESC\n) latest",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Wins"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Losses"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Account",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Balance vs Equity",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT observed_at AS \"time\", balance AS \"Balance\", equity AS \"Equity\"\nFROM account_snapshots\nWHERE $__timeFilter(observed_at)\n  AND bot_id = '$bot_id'\nORDER BY 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aurum-postgres"
          },
          "rawQuery": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Balance"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Equity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
