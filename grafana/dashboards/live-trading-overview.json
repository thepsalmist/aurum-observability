        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aurum-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT occurred_at      AS \"Time\",\n       symbol           AS \"Symbol\",\n       payload->>'code' AS \"Code\",\n       reason           AS \"Message\"\nFROM trade_events\nWHERE event_type = 'ERROR'\n  AND $__timeFilter(occurred_at)\n  AND bot_id = '$bot_id' AND symbol LIKE '$symbol'\nORDER BY occurred_at DESC\nLIMIT 50",
